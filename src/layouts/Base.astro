---
import '@fontsource-variable/archivo';
import '@fontsource/archivo-black';
import '../styles/global.css';
import { navigation as ladeNavigation } from '../lib/seiten';
import { verein } from '../lib/einstellungen';

const navigation = await ladeNavigation();
const site = { name: verein.name || 'Newtown United e.V.' };

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Newtown United e.V. – Sport- und Kulturverein aus Dresden.' } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : site.name;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="rot-linie"></div>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          {verein.logo && <img src={verein.logo} alt="" width="44" height="44" />}
          <span>Newtown United <small>e.V.</small></span>
        </a>
        <div class="mobile-nav">
          <input type="checkbox" id="nav-toggle" class="nav-toggle" />
          <label for="nav-toggle" class="nav-button">Menü</label>
          <nav aria-label="Hauptmenü">
            <ul>
              {navigation.map((item) => (
                <li class={item.children.length > 0 ? 'has-children' : ''}>
                  <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
                  {item.children.length > 0 && (
                    <ul>
                      {item.children.map((child) => (
                        <li><a href={child.href} class={isActive(child.href) ? 'active' : ''}>{child.label}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <strong>{site.name}</strong><br />
          {verein.untertitel}
        </div>
        <ul>
          {verein.instagram && <li><a href={verein.instagram} rel="noopener">Instagram</a></li>}
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/impressum/#datenschutz">Datenschutz</a></li>
        </ul>
        <div class="copy">© {new Date().getFullYear()} {site.name}</div>
      </div>
      <div class="rot-linie"></div>
    </footer>
  </body>
</html>

<style>
  .site-header { background: var(--bg); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 68px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg); font-family: var(--font-display); font-size: 1.15rem; }
  .brand small { font-family: var(--font-body); font-weight: 700; font-size: .8rem; color: var(--link); }

  .nav-toggle { position: absolute; opacity: 0; pointer-events: none; }
  .nav-button { cursor: pointer; font-weight: 700; padding: 6px 16px; border: 2px solid var(--fg); border-radius: 999px; user-select: none; }
  .nav-toggle:focus-visible + .nav-button { outline: 3px solid var(--link); outline-offset: 2px; }
  .mobile-nav nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--bg); border-bottom: 1px solid var(--line); padding: 8px 16px 18px; }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
  .mobile-nav li ul { padding-left: 16px; }
  .mobile-nav a { display: block; padding: 8px 0; color: var(--fg); text-decoration: none; font-weight: 600; }
  .mobile-nav a.active { color: var(--link); }
  .nav-toggle:checked ~ nav { display: block; }

  @media (min-width: 900px) {
    .nav-button { display: none; }
    .mobile-nav nav { display: block; position: static; background: none; border: 0; padding: 0; }
    .mobile-nav > nav > ul { display: flex; gap: 4px; }
    .mobile-nav > nav > ul > li { position: relative; }
    .mobile-nav > nav > ul > li > a { padding: 8px 12px; border-radius: 999px; }
    .mobile-nav > nav > ul > li > a:hover, .mobile-nav a.active { background: var(--rot); color: var(--fg); }
    .has-children > ul {
      display: none; position: absolute; top: 100%; left: 0; min-width: 230px;
      background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
      padding: 8px !important; box-shadow: 0 12px 28px rgba(0,0,0,.5);
    }
    .has-children:hover > ul, .has-children:focus-within > ul { display: block; }
    .has-children > ul a { padding: 8px 10px; border-radius: 8px; }
    .has-children > ul a:hover { background: var(--surface-2); }
    .has-children > ul a.active { background: none; color: var(--link); }
  }

  .site-footer { margin-top: 64px; background: var(--surface); color: var(--fg); border-top: 1px solid var(--line); }
  .foot { display: grid; gap: 18px; padding-top: 36px; padding-bottom: 36px; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 18px; }
  .foot a { color: var(--link); }
  .foot a:hover { color: var(--fg); }
  .copy { opacity: .6; font-size: .9rem; }
  @media (min-width: 720px) { .foot { grid-template-columns: 1fr auto; } .copy { grid-column: 1 / -1; } }
</style>
