---
import Base from '../layouts/Base.astro';
import TextPending from '../components/TextPending.astro';
import Picture from '../components/Picture.astro';
---
<Base title="LOUD & UNITED">
  <section class="hero wrap">
    <div class="split">
      <div>
        <span class="kicker">Kultur</span>
        <h1>LOUD &amp; UNITED</h1>
        <TextPending />
      </div>
      <Picture src="/images/loud-united.jpg" alt="LOUD &amp; UNITED" />
    </div>
  </section>
</Base>
