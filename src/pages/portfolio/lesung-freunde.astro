---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import Picture from '../../components/Picture.astro';
const tickets = 'https://eventfrog.de/de/p/theater-buehne/lesung/freunde-lesung-diskussion-7472278986334146380.html';
---
<Base title="Lesung „Freunde“" description="Lesung zum Antikriegsroman „Freunde“ von Eva Kranenburg am 23.08.2026 in Dresden. Eintritt frei.">
  <section class="hero wrap">
    <div class="split">
      <div>
        <span class="kicker">Lesung zum Antikriegsroman „Freunde“</span>
        <h1>Wie viel Menschlichkeit steckt in dir, wenn die Welt untergeht?</h1>
        <p class="lead">
          Eine ehrliche, emotionale und hoffnungsvolle Geschichte über Freundschaft, Verlust, Mut, Menschlichkeit und Hoffnung.
          Für Jugendliche ab 12 Jahren und Erwachsene.
        </p>
        <div class="btn-row">
          <a class="btn" href={tickets} rel="noopener">Tickets bei Eventfrog</a>
          <a class="btn ghost" href="#anmelden">Platz reservieren</a>
        </div>
      </div>
      <Picture src="/images/lesung-freunde-1.png" alt="Plakat Lesung „Freunde“" ratio="1 / 1" />
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="prose">
        <h2>Worum es geht</h2>
        <p>
          Vier Jugendliche. Ein Krieg, der alles zerstört. Eine Flucht, die sie zusammenschweißt.
          Diese Lesung lädt dazu ein, gemeinsam über Fragen nachzudenken, die heute aktueller sind denn je:
        </p>
        <ul>
          <li>Was macht uns menschlich?</li>
          <li>Wie entstehen Vorurteile?</li>
          <li>Was gibt Hoffnung?</li>
          <li>Wie wichtig sind Freundschaft und Zusammenhalt?</li>
        </ul>
        <h2>Eva Kranenburg</h2>
        <p>
          Autorin des ausgezeichneten Jugendromans „Freunde“, der sich auf bewegende und zugleich hoffnungsvolle
          Weise mit Krieg, Flucht und Menschlichkeit auseinandersetzt.
        </p>
      </div>
      <div class="info-box">
        <h3>Veranstaltungsdaten</h3>
        <dl>
          <dt>Datum</dt><dd>23.08.2026</dd>
          <dt>Einlass</dt><dd>ab 14:00 Uhr</dd>
          <dt>Ort</dt><dd>Großenhainer Str. 93, Dresden</dd>
          <dt>Eintritt</dt><dd>frei (Voranmeldung erwünscht)</dd>
          <dt>Alter</dt><dd>ab 12 Jahren</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="section wrap" id="anmelden">
    <h2>Du möchtest dabei sein?</h2>
    <p>Dann sichere dir dein Ticket über Eventfrog oder schick uns eine Nachricht. Wir reservieren dir gerne deinen Platz.</p>
    <ContactForm subject="Lesung „Freunde“ – Platzreservierung" submitLabel="Platz reservieren" />
  </section>
</Base>
