---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Picture from '../components/Picture.astro';
---
<Base title="Blind Kick" description="Blind Kick auf der Torgauer Straße in Dresden: Street Football, Blindkick-Turniere, Blind Basketball und mehr.">
  <section class="hero wrap">
    <div class="split">
      <div>
        <span class="kicker">Newtown United präsentiert</span>
        <h1>Blind Kick</h1>
        <p class="lead">
          Nachdem wir die letzten Jahre für volle Ränge und Straßen sorgen konnten, bringen wir auch diesmal wieder
          Blindkick, Street Football und jede Menge Chaos &amp; Spaß auf die Torgauer Straße.
        </p>
        <div class="info-box">
          <dl>
            <dt>Wann</dt><dd>06.06. &amp; 07.06.2026</dd>
            <dt>Wo</dt><dd>Torgauer Straße, Dresden</dd>
          </dl>
        </div>
      </div>
      <Picture src="/images/blindkick.jpeg" alt="Blind Kick auf der Torgauer Straße" />
    </div>
  </section>

  <section class="section wrap">
    <h2>Programm</h2>
    <div class="cards">
      <div class="card">
        <h3>Samstag, 06.06. ab 14 Uhr</h3>
        <ul class="plain">
          <li>⚽️ Free Kick – Street Football &amp; Blindkick-Probelauf</li>
          <li>🏀 Blind Freiwurf Basketball</li>
          <li>🎳 Blind Kegeln</li>
          <li>✨ Glitzertattoos &amp; Buttons selber machen</li>
        </ul>
      </div>
      <div class="card">
        <h3>Sonntag, 07.06. ab 12 Uhr</h3>
        <ul class="plain">
          <li>⚽️ Blindkick-Turniere im 2er-Team (eine Spielerin oder ein Spieler, eine Koordinatorin oder ein Koordinator)</li>
          <li>🏆 Stündlich heißt es: Best of Four</li>
          <li>✨ Glitzertattoos &amp; Buttons selber machen</li>
          <li>Anmeldung erwünscht</li>
        </ul>
      </div>
    </div>
    <p style="margin-top:1.2em">
      Natürlich läuft auch wieder die Buttonmaschine heiß und ihr könnt euch mit Glitzertattoos eindecken, solange der Vorrat reicht.
    </p>
  </section>

  <section class="section wrap">
    <div class="flyers">
      <Picture src="/images/blindkick-flyer-1.png" alt="Flyer Blind Kick" ratio="724 / 1024" />
      <Picture src="/images/blindkick-flyer-2.png" alt="Flyer Blind Kick Programm" ratio="724 / 1024" />
    </div>
  </section>

  <section class="section wrap">
    <h2>Anmelden oder Fragen stellen</h2>
    <ContactForm subject="Blind Kick" submitLabel="Nachricht senden" />
  </section>
</Base>

<style>
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .flyers { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); max-width: 760px; }
</style>
