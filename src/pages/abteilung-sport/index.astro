---
import Base from '../../layouts/Base.astro';
import TextPending from '../../components/TextPending.astro';
---
<Base title="Abteilung Sport">
  <section class="hero wrap">
    <span class="kicker">Newtown United e.V.</span>
    <h1>Abteilung Sport</h1>
    <TextPending />
  </section>
  <section class="section wrap">
    <div class="cards">
      <a class="card" style="--c: var(--bunt-1)" href="/abteilung-sport/bunte-liga-dresden/">
        <h3>BUNTE Liga Dresden</h3><p>Inklusive Freizeitliga für Dresden und Umgebung.</p>
      </a>
      <a class="card" style="--c: var(--bunt-2)" href="/abteilung-sport/ping-pong-united/">
        <h3>Ping Pong United</h3><p>Tischtennis in geselliger Runde.</p>
      </a>
      <a class="card" style="--c: var(--bunt-3)" href="/abteilung-sport/sport-fuer-alle/">
        <h3>Sport für Alle</h3><p>Bewegung für jede und jeden.</p>
      </a>
    </div>
  </section>
</Base>
