---
// Zeigt ein Bild aus /public/images. Fehlt die Datei noch, erscheint ein Platzhalter.
import fs from 'node:fs';
import path from 'node:path';

interface Props { src: string; alt: string; ratio?: string; class?: string }
const { src, alt, ratio = '4 / 3', class: className } = Astro.props;
const exists = fs.existsSync(path.join(process.cwd(), 'public', src));
---
{exists
  ? <img src={src} alt={alt} class:list={['pic', className]} loading="lazy" decoding="async" />
  : <div class:list={['placeholder-img', className]} style={`aspect-ratio: ${ratio}`}>Bild folgt: {alt}</div>}

<style>
  .pic { border-radius: var(--radius); width: 100%; }
</style>
