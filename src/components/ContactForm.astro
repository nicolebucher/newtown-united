---
// Formular läuft über FormSubmit (https://formsubmit.co), Nachrichten gehen an die Vereins-E-Mail
// (Einstellungen → Verein). Beim allerersten Absenden kommt dort eine Mail zum Bestätigen.
import { verein } from '../lib/einstellungen';
interface Props {
  subject?: string;
  subjects?: string[];
  submitLabel?: string;
  showMessage?: boolean;
  art?: 'kontakt' | 'team';
}
const {
  subject,
  subjects = ['Allgemeine Anfrage', 'Mitgliedschaft', 'BUNTE Liga', 'St. Pieschen', 'Lesung „Freunde“'],
  submitLabel = 'Absenden',
  showMessage = true,
  art = 'kontakt',
} = Astro.props;
const empfaenger = verein.email || 'newtownunited@web.de';
---
<form class="contact-form" action={`https://formsubmit.co/${empfaenger}`} method="POST">
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_next" value="/danke/" data-danke />
  <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" />
  {art === 'team' && <label>Teamname<input name="teamname" required /></label>}
  <label>{art === 'team' ? 'Ansprechperson' : 'Name'}<input name="name" required autocomplete="name" /></label>
  <label>E-Mail<input type="email" name="email" required autocomplete="email" /></label>
  {art === 'team' && (
    <div class="zwei">
      <label>Telefon (optional)<input type="tel" name="telefon" autocomplete="tel" /></label>
      <label>Anzahl Spieler:innen (ca.)<input type="number" name="anzahl_spielerinnen" min="1" max="40" inputmode="numeric" /></label>
    </div>
  )}
  {subject ? (
    <input type="hidden" name="_subject" value={subject} />
  ) : (
    <label>Betreff
      <select name="_subject">{subjects.map((s) => <option>{s}</option>)}</select>
    </label>
  )}
  {showMessage && <label>{art === 'team' ? 'Nachricht (optional)' : 'Nachricht'}<textarea name="message" rows="5" required={art !== 'team'}></textarea></label>}
  <label class="consent">
    <input type="checkbox" required />
    <span>Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage gespeichert werden. Mehr dazu in der <a href="/impressum/#datenschutz">Datenschutzerklärung</a>.</span>
  </label>
  <button class="btn" type="submit">{submitLabel}</button>
</form>

<script>
  // FormSubmit braucht die Danke-Seite als vollständige Adresse.
  document.querySelectorAll<HTMLInputElement>('input[data-danke]').forEach((el) => {
    el.value = new URL('/danke/', location.origin).href;
  });
</script>

<style>
  .contact-form { display: grid; gap: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; max-width: 560px; }
  label { display: grid; gap: 6px; font-weight: 600; }
  input, select, textarea { font: inherit; padding: 10px 12px; border: 1.5px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--fg); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--link); }
  .consent { grid-template-columns: auto 1fr; align-items: start; font-weight: 400; font-size: .92rem; }
  .consent input { margin-top: 4px; accent-color: var(--rot); }
  .hp { display: none; }
  .zwei { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  button { justify-self: start; }
</style>
